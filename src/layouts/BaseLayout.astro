---
import type { Lang } from "../i18n";
import { defaultLang, getDict, languages } from "../i18n";
import { baseRoute, jsonLd, localeUrl, ogLocale, siteOrigin } from "../lib/seo";
import LogoHandoff from "../components/LogoHandoff.astro";
import { readFileSync } from "node:fs";
import { join } from "node:path";

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  /** Pagine da non indicizzare (404): niente canonical, hreflang né schema. */
  noindex?: boolean;
  /** false = niente loader iniziale (es. 404: si arriva da un link rotto). */
  loader?: boolean;
}

const {
  lang = defaultLang,
  title = "AuralpDigital — Sistemi digitali che generano clienti",
  description = "Studio di crescita digitale in Alto Adige. Siti web premium, lead generation, campagne ads, brand & social, automazioni, AI integration.",
  noindex = false,
  loader = true,
} = Astro.props;

// SEO: URL canonico, alternative di lingua (hreflang), Open Graph, JSON-LD.
const origin = siteOrigin(Astro.site);
const route = baseRoute(Astro.url.pathname);
const canonical = localeUrl(origin, lang, route);
const ogImage = `${origin}/og/og-${lang}.png`;
// `<` escapato: il JSON non può mai chiudere il tag <script> per errore.
// Logo in negativo della transizione tra pagine, come SVG nel codice (non
// un'immagine da caricare): si disegna insieme alla navy dal primo
// fotogramma, senza il "flash" di un'immagine ancora da decodificare.
const ptLogo = readFileSync(join(process.cwd(), "public/logo/wordmark-reversed.svg"), "utf8")
  .trim()
  .replace(/\s*\n\s*/g, " ")
  .replace("<svg ", '<svg aria-hidden="true" focusable="false" ');
const schema = noindex ? null : JSON.stringify(jsonLd({ origin, lang, route, title, description })).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
        <link rel="canonical" href={canonical} />
        {languages.map((l) => <link rel="alternate" hreflang={l} href={localeUrl(origin, l, route)} />)}
        <link rel="alternate" hreflang="x-default" href={localeUrl(origin, defaultLang, route)} />
      </>
    )}
    <meta name="author" content="AuralpDigital" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Open Graph / anteprime social (WhatsApp, LinkedIn, Facebook, X). -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AuralpDigital" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {languages.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="geo.region" content="IT-BZ" />
    <meta name="geo.placename" content="Bolzano" />
    <meta name="geo.position" content="46.4983;11.3548" />
    <meta name="ICBM" content="46.4983, 11.3548" />
    {schema && <script type="application/ld+json" set:html={schema} />}
    <!-- Sistema tipografico: Satoshi (Fontshare, licenza ITF FFL) su tutto il
         sito — display e body sulla stessa famiglia. Le due varianti
         VARIABILI (tondo + corsivo, asse wght 300..900) sono ospitate qui in
         /fonts: niente CSS esterno bloccante né connessioni a due domini
         Fontshare prima del primo testo. Il corsivo è vero, non simulato.
         Niente preload: misurato su rete lenta, i due woff2 rubavano banda
         al CSS bloccante e il primo paint arrivava ~400ms più tardi. -->
    <style is:inline>
      @font-face {
        font-family: "Satoshi";
        src: url("/fonts/satoshi-variable.woff2") format("woff2");
        font-weight: 300 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Satoshi";
        src: url("/fonts/satoshi-variable-italic.woff2") format("woff2");
        font-weight: 300 900;
        font-style: italic;
        font-display: swap;
      }
    </style>
    <title>{title}</title>

    <!-- Loader: decisione SINCRONA prima del render per evitare flash. Se la
         sessione ha già visto il loader, lo si salta (skip); altrimenti si
         blocca lo scroll finché il loader è attivo. -->
    <script is:inline>
      (function () {
        try {
          if (sessionStorage.getItem("apd:loaded")) {
            document.documentElement.classList.add("apd-skip-loader");
          } else {
            document.documentElement.classList.add("apd-loading");
          }
        } catch (e) {
          document.documentElement.classList.add("apd-loading");
        }
        // Scene in regia (stessa condizione di `staticScenes` in main.ts):
        // decisa qui, prima del primo render, così il layout delle sezioni
        // pinnate (es. .point, palco alto una schermata) è già quello
        // finale e non salta quando parte il modulo (era CLS visibile).
        if (
          !matchMedia("(prefers-reduced-motion: reduce)").matches &&
          !matchMedia("(max-height: 500px) and (orientation: landscape) and (hover: none)").matches
        ) {
          document.documentElement.classList.add("apd-scenes");
        }
      })();
    </script>
    <!-- Page wipe (vedi scripts/pageWipe.ts e global.css): transizione tra
         pagine fatta a mano con animazioni CSS, uguale su ogni browser.
         - Click su un link del sito verso un'ALTRA pagina: le fasce coprono
           lo schermo, sulla navy c'è il logo (.pt-leave), poi si naviga.
         - La pagina nuova trova il segno in sessionStorage e nasce identica,
           navy col logo (.pt-arrive, messa qui prima del primo disegno);
           quando è pronta (DOMContentLoaded) si sposta lei sullo schermo
           (.pt-go). Verso la Home tutto al contrario (.pt-rev).
         Indietro/avanti o un URL digitato: nessuna transizione. Passando
         sopra un link interno la pagina viene prefetchata. -->
    <script is:inline define:vars={{ ptLogo }}>
      (function () {
        var KEY = "apd:wipe";
        // Fasce posate (0.12s + 0.65s): si naviga.
        var GO = 780;
        var root = document.documentElement;
        var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        var leaving = false;
        var arriving = false;

        // ---------- Arrivo ----------
        try {
          var mark = (sessionStorage.getItem(KEY) || "").split("|");
          sessionStorage.removeItem(KEY);
          var since = Date.now() - Number(mark[0]);
          if (!reduce && since >= 0 && since < 10000) {
            arriving = true;
            root.classList.add("pt-arrive");
            if (mark[1] === "rev") root.classList.add("pt-rev");
            // Il logo dell'attesa sta FUORI dal body (figlio di <html>, prima
            // del body): resta fermo mentre la pagina gli scorre sopra.
            var logo = document.createElement("div");
            logo.className = "pt-logo pt-logo-arrive";
            logo.setAttribute("aria-hidden", "true");
            logo.innerHTML = ptLogo;
            root.appendChild(logo);
          }
        } catch (e) {}

        // Fine arrivo: il body torna senza transform (altrimenti gli elementi
        // fissi seguirebbero la pagina). Se si sta già uscendo, .pt-rev ora è
        // il verso dell'uscita e resta.
        function endArrive() {
          arriving = false;
          root.classList.remove("pt-arrive", "pt-go");
          var l = document.querySelector(".pt-logo-arrive");
          if (l) l.remove();
          if (!leaving) root.classList.remove("pt-rev");
        }
        if (arriving) {
          var started = false;
          var slide = function () {
            if (started || !arriving) return;
            started = true;
            root.classList.add("pt-go");
            setTimeout(endArrive, 1500); // rete di sicurezza
          };
          // La pagina scorre solo quando il browser è libero: dopo
          // DOMContentLoaded le pagine avviano la loro parte pesante (3D,
          // GSAP…) e uno scorrimento partito lì si inchiodava a metà. Si
          // aspettano 4 fotogrammi regolari di fila (al massimo 1.2s): intanto
          // resta la navy col logo.
          var settle = function () {
            var t0 = performance.now();
            var last = t0;
            var calm = 0;
            var tick = function (t) {
              calm = t - last < 34 ? calm + 1 : 0;
              last = t;
              if (calm >= 4 || t - t0 > 1200) slide();
              else requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          };
          if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", settle);
          } else settle();
          setTimeout(slide, 4000);
          document.addEventListener("animationend", function (e) {
            if (/^pt-page-in/.test(e.animationName)) endArrive();
          });
        }

        // ---------- Uscita ----------
        // Home di ogni lingua: "/", "/de", "/en".
        function isHome(path) {
          return /^\/?(de|en)?\/?$/.test(path);
        }
        // Link verso un'ALTRA pagina dello stesso sito (non ancore di questa).
        function crossPage(a) {
          if (!a || !a.href || a.hasAttribute("download")) return null;
          if (a.target && a.target !== "_self") return null;
          var url = new URL(a.href, location.href);
          if (url.origin !== location.origin) return null;
          if (url.pathname.replace(/\/$/, "") === location.pathname.replace(/\/$/, "")) return null;
          return url;
        }

        document.addEventListener("click", function (e) {
          if (leaving || e.defaultPrevented || reduce) return;
          if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
          var url = crossPage(a);
          if (!url) return;
          e.preventDefault();
          leaving = true;
          var rev = isHome(url.pathname);
          try {
            sessionStorage.setItem(KEY, Date.now() + (rev ? "|rev" : "|fwd"));
          } catch (err) {}
          endArrive();
          root.classList.toggle("pt-rev", rev);
          root.classList.add("pt-leave");
          prefetch(url);
          setTimeout(function () {
            location.assign(url.href);
          }, GO);
        });

        // Tornando con indietro/avanti dalla cache la pagina dev'essere pulita.
        window.addEventListener("pageshow", function (e) {
          if (!e.persisted) return;
          leaving = false;
          endArrive();
          root.classList.remove("pt-leave", "pt-rev");
        });

        // ---------- Prefetch ----------
        var fetched = {};
        function prefetch(url) {
          if (!url || fetched[url.pathname]) return;
          fetched[url.pathname] = true;
          var l = document.createElement("link");
          l.rel = "prefetch";
          l.href = url.pathname;
          document.head.appendChild(l);
        }
        function hint(e) {
          var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
          prefetch(crossPage(a));
        }
        document.addEventListener("pointerover", hint, { passive: true });
        document.addEventListener("focusin", hint);
        document.addEventListener("touchstart", hint, { passive: true });
      })();
    </script>
  </head>
  <body class="bg-[#FFFFFF] text-[#171310] overflow-x-clip">
    <!-- Logo handoff: l'UNICO logo animato della pagina, fisso e sopra a
         tutto, fuori da navbar e hero. Al primo ingresso della sessione fa da
         preloader (con il suo velo); poi si posa nella hero e con lo scroll
         arriva al posto del logo della navbar (scripts/logoHandoff.ts). -->
{loader && <LogoHandoff />}


    <!-- Transizione tra pagine: le due fasce blu (Shadow, poi navy). Nascoste
         fuori transizione; le muovono .pt-leave / .pt-arrive (global.css). -->
    <div class="page-wipe" aria-hidden="true">
      <div class="page-wipe-layer" style="background:#2748A5"></div>
      <div class="page-wipe-layer" style="background:#1C2B5F">
        <div class="pt-logo" set:html={ptLogo} />
      </div>
    </div>

    <!-- Barra di avanzamento scroll — lato destro -->
    <div id="scroll-track">
      <div id="scroll-fill"></div>
    </div>

    <!-- Torna su — compare dalla seconda sezione, sparisce sul footer
         (che ha già il suo). Comportamento in main.ts. -->
    <button type="button" class="to-top" data-to-top aria-label={getDict(lang).footer.backToTop} title={getDict(lang).footer.backToTop}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5" /><path d="M18 11l-6-6-6 6" />
      </svg>
    </button>

    <slot />

    <script>
      // Prima il logo: main.ts si monta a pezzi (await) e non deve farlo aspettare.
      import "../scripts/logoHandoff.ts";
      import "../scripts/main.ts";
    </script>
  </body>
</html>
