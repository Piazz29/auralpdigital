---
import type { Lang } from "../i18n";
import { defaultLang, getDict, languages } from "../i18n";
import { baseRoute, jsonLd, localeUrl, ogLocale, siteOrigin } from "../lib/seo";

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  /** Pagine da non indicizzare (404): niente canonical, hreflang né schema. */
  noindex?: boolean;
  /** false = niente loader iniziale (es. 404: si arriva da un link rotto). */
  loader?: boolean;
}

const {
  lang = defaultLang,
  title = "AuralpDigital — Sistemi digitali che generano clienti",
  description = "Studio di crescita digitale in Alto Adige. Siti web premium, lead generation, campagne ads, brand & social, automazioni, AI integration.",
  noindex = false,
  loader = true,
} = Astro.props;

// SEO: URL canonico, alternative di lingua (hreflang), Open Graph, JSON-LD.
const origin = siteOrigin(Astro.site);
const route = baseRoute(Astro.url.pathname);
const canonical = localeUrl(origin, lang, route);
const ogImage = `${origin}/og/og-${lang}.png`;
// `<` escapato: il JSON non può mai chiudere il tag <script> per errore.
const schema = noindex ? null : JSON.stringify(jsonLd({ origin, lang, route, title, description })).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
        <link rel="canonical" href={canonical} />
        {languages.map((l) => <link rel="alternate" hreflang={l} href={localeUrl(origin, l, route)} />)}
        <link rel="alternate" hreflang="x-default" href={localeUrl(origin, defaultLang, route)} />
      </>
    )}
    <meta name="author" content="AuralpDigital" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Open Graph / anteprime social (WhatsApp, LinkedIn, Facebook, X). -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AuralpDigital" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {languages.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="geo.region" content="IT-BZ" />
    <meta name="geo.placename" content="Bolzano" />
    <meta name="geo.position" content="46.4983;11.3548" />
    <meta name="ICBM" content="46.4983, 11.3548" />
    {schema && <script type="application/ld+json" set:html={schema} />}
    <!-- La wordmark è nel loader: preload così è lì dal primo frame. -->
    <link rel="preload" as="image" href="/logo/wordmark.svg" type="image/svg+xml" />
    <!-- Sistema tipografico: Satoshi (Fontshare, licenza ITF FFL) su tutto il
         sito — display e body sulla stessa famiglia. Le due varianti
         VARIABILI (tondo + corsivo, asse wght 300..900) sono ospitate qui in
         /fonts: niente CSS esterno bloccante né connessioni a due domini
         Fontshare prima del primo testo. Il corsivo è vero, non simulato.
         Niente preload: misurato su rete lenta, i due woff2 rubavano banda
         al CSS bloccante e il primo paint arrivava ~400ms più tardi. -->
    <style is:inline>
      @font-face {
        font-family: "Satoshi";
        src: url("/fonts/satoshi-variable.woff2") format("woff2");
        font-weight: 300 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Satoshi";
        src: url("/fonts/satoshi-variable-italic.woff2") format("woff2");
        font-weight: 300 900;
        font-style: italic;
        font-display: swap;
      }
    </style>
    <title>{title}</title>

    <!-- Loader: decisione SINCRONA prima del render per evitare flash. Se la
         sessione ha già visto il loader, lo si salta (skip); altrimenti si
         blocca lo scroll finché il loader è attivo. -->
    <script is:inline>
      (function () {
        try {
          if (sessionStorage.getItem("apd:loaded")) {
            document.documentElement.classList.add("apd-skip-loader");
          } else {
            document.documentElement.classList.add("apd-loading");
          }
        } catch (e) {
          document.documentElement.classList.add("apd-loading");
        }
        // Scene in regia (stessa condizione di `staticScenes` in main.ts):
        // decisa qui, prima del primo render, così il layout delle sezioni
        // pinnate (es. .point, che sale di 30vh sulla hero) è già quello
        // finale e non salta quando parte il modulo (era CLS visibile).
        if (
          !matchMedia("(prefers-reduced-motion: reduce)").matches &&
          !matchMedia("(max-height: 500px) and (orientation: landscape) and (hover: none)").matches
        ) {
          document.documentElement.classList.add("apd-scenes");
        }
      })();
    </script>
    <!-- Page wipe (vedi scripts/pageWipe.ts): la View Transition tra pagine
         parte SOLO se il cambio pagina è nato da un click su un link del sito
         (navbar, footer, CTA, lingua…) — non da indietro/avanti o da un URL
         digitato. Dev'essere uno script classico in <head>:
         - il click si marca in CATTURA sul document, attivo dal primo istante:
           non dipende dall'idratazione della navbar (cliccare prima che React
           partisse faceva saltare le fasce);
         - `pagereveal` scatta prima del primo render della pagina nuova, prima
           che un modulo differito possa ascoltarlo.
         Il flag si consuma subito, così non resta appeso nei browser senza
         supporto. Passando sopra un link interno la pagina viene prefetchata:
         la vecchia resta ferma il meno possibile prima della transizione. -->
    <script is:inline>
      (function () {
        var KEY = "apd:wipe";
        var wipe = false;
        try {
          // Vale solo se il click è recente: un click annullato non deve far
          // partire le fasce su una navigazione successiva (indietro, URL…).
          var at = Number(sessionStorage.getItem(KEY));
          wipe = at > 0 && Date.now() - at < 15000;
          sessionStorage.removeItem(KEY);
        } catch (e) {}

        // Link verso un'ALTRA pagina dello stesso sito (non ancore di questa).
        function crossPage(a) {
          if (!a || !a.href || a.hasAttribute("download")) return null;
          if (a.target && a.target !== "_self") return null;
          var url = new URL(a.href, location.href);
          if (url.origin !== location.origin) return null;
          if (url.pathname.replace(/\/$/, "") === location.pathname.replace(/\/$/, "")) return null;
          return url;
        }
        document.addEventListener(
          "click",
          function (e) {
            if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
            if (!crossPage(a)) return;
            try {
              sessionStorage.setItem(KEY, String(Date.now()));
            } catch (err) {}
          },
          true
        );
        var fetched = {};
        function hint(e) {
          var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
          var url = crossPage(a);
          if (!url || fetched[url.pathname]) return;
          fetched[url.pathname] = true;
          var l = document.createElement("link");
          l.rel = "prefetch";
          l.href = url.pathname;
          document.head.appendChild(l);
        }
        document.addEventListener("pointerover", hint, { passive: true });
        document.addEventListener("focusin", hint);

        // .vt-arrive mette in vista le fasce e dà i nomi alla transizione:
        // non deve MAI restare addosso alla pagina fuori da una transizione,
        // o le fasce coprirebbero tutto. Si toglie da più strade (la prima
        // che arriva vince, le altre non fanno nulla).
        var root = document.documentElement;
        var safety = 0;
        function endArrive() {
          clearTimeout(safety);
          root.classList.remove("vt-arrive");
        }

        window.addEventListener("pagereveal", function (e) {
          var vt = e.viewTransition;
          endArrive();
          if (!vt) return;
          if (!wipe || matchMedia("(prefers-reduced-motion: reduce)").matches) {
            vt.skipTransition();
            return;
          }
          wipe = false;
          root.classList.add("vt-arrive");
          // 1) fine normale (o transizione saltata/annullata dal browser);
          vt.finished.then(endArrive, endArrive);
          // 2) rete di sicurezza: se per qualunque motivo `finished` non
          //    arrivasse, a animazioni finite (~1.4s dopo `ready`) si pulisce
          //    comunque. Se `ready` fallisce la transizione non c'è: via subito.
          vt.ready.then(function () {
            safety = setTimeout(endArrive, 2400);
          }, endArrive);
        });
        // 3) Si lascia la pagina mentre arriva ancora (indietro, un altro
        //    link): la pagina vecchia deve farsi fotografare SENZA i nomi
        //    della transizione d'arrivo, o la nuova li erediterebbe.
        window.addEventListener("pageswap", endArrive);
        // 4) Pagina messa in / ripresa dalla cache avanti-indietro: torna
        //    sempre pulita.
        window.addEventListener("pagehide", endArrive);
        window.addEventListener("pageshow", function (e) {
          if (e.persisted) endArrive();
        });
      })();
    </script>
  </head>
  <body class="bg-[#FFFFFF] text-[#171310] overflow-x-clip">
    <!-- First-load loader: wordmark del brand (colori identici al logo SVG) e,
         sotto, un loader 3D a cuboide. Primo figlio del body così copre tutto
         fin da subito; rimosso dallo script dopo un minimo di 3s. -->
{loader && (
    <div id="apd-loader" class="apd-loader" role="presentation" aria-hidden="true">
      <div class="apd-loader-inner">
        <img
          class="apd-mark-img"
          src="/logo/wordmark.svg"
          alt="AuralpDigital"
          width="556"
          height="119"
        />
        <div class="apd-cuboid" aria-hidden="true">
          <div class="scene">
            <div class="shadow"></div>
            <div class="jumper">
              <div class="spinner">
                <div class="scaler">
                  <div class="loader">
                    <div class="cuboid">
                      <div class="cuboid__side"></div>
                      <div class="cuboid__side"></div>
                      <div class="cuboid__side"></div>
                      <div class="cuboid__side"></div>
                      <div class="cuboid__side"></div>
                      <div class="cuboid__side"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    )}


    <!-- Transizione tra pagine: le due fasce blu del vecchio menu. Restano
         fuori schermo a destra; solo durante la View Transition (.vt-arrive)
         si mettono in vista per farsi fotografare intere (global.css). -->
    <div class="page-wipe" aria-hidden="true">
      <div class="page-wipe-layer" style="background:#2748A5"></div>
      <div class="page-wipe-layer" style="background:#1C2B5F"></div>
    </div>

    <!-- Barra di avanzamento scroll — lato destro -->
    <div id="scroll-track">
      <div id="scroll-fill"></div>
    </div>

    <!-- Torna su — compare dalla seconda sezione, sparisce sul footer
         (che ha già il suo). Comportamento in main.ts. -->
    <button type="button" class="to-top" data-to-top aria-label={getDict(lang).footer.backToTop} title={getDict(lang).footer.backToTop}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5" /><path d="M18 11l-6-6-6 6" />
      </svg>
    </button>

    <slot />

    <script>
      import "../scripts/loader.ts";
      import "../scripts/main.ts";
    </script>
  </body>
</html>
