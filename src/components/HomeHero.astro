---
// HERO della home — "luce liquida". Su bianco carta una luce blu e arancio
// scorre lenta come un fluido (shader WebGL in scripts/heroFluid.ts, segue
// appena il mouse). A sinistra il titolo, grande, il sottotitolo e la CTA;
// a destra la vista esplosa: un sito d'esempio si apre a strati, dal codice
// all'interazione, come un disegno tecnico.
// Niente foto del team: le persone stanno in Chi siamo.
//
// Sotto la piega la luce si scioglie nel bianco e la sezione diventa
// trasparente: Il punto le scorre sotto senza cuciture.
// Entrate e parallasse in scripts/logoHandoff.ts (il logo del preloader vola
// nella navbar, la hero si apre col cerchio che lo segue).
import type { Lang } from "../i18n";
import { getDict } from "../i18n";
import Rich from "./Rich.astro";
import { Image } from "astro:assets";
import sciliar from "../assets/point/sciliar-bw.png";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang);
const x = t.home.hero.explode;
// Telefono: la didascalia sotto lo Sciliar.
const TAG = { it: "Sciliar · Alto Adige", de: "Schlern · Südtirol", en: "Sciliar · South Tyrol" }[lang];
// Il codice dello strato più basso: la stessa pagina che si vede in cima.
type Tok = [string, string];
const CODE: Tok[][] = [
  [["c", "---"]],
  [["k", "import "], ["t", "Booking"], ["k", " from "], ["s", '"@/ui"']],
  [["c", "---"]],
  [["p", "<"], ["t", "Nav"], ["a", " brand"], ["p", "="], ["s", '"Baita Sciliar"'], ["p", " />"]],
  [["p", "<"], ["t", "Hero"], ["a", " img"], ["p", "="], ["s", '"sciliar.avif"'], ["p", ">"]],
  [["p", "  <"], ["t", "h1"], ["p", ">"], ["x", `${x.site.title.split(" ").slice(0, 2).join(" ")}…`], ["p", "</"], ["t", "h1"], ["p", ">"]],
  [["p", "</"], ["t", "Hero"], ["p", ">"]],
  [["p", "<"], ["t", "Booking"], ["a", " autoReply"], ["a", " seo"], ["p", " />"]],
  [["p", "<"], ["t", "Chat"], ["a", " ai"], ["p", "="], ["s", '"24/7"'], ["p", " />"]],
];
---

<section id="top" class="hero-section hero-fluid relative w-full overflow-hidden" data-anim="hero" data-handoff-hero>
  <!-- La luce: canvas WebGL. Il fondo CSS sotto è la stessa scena, ferma:
       si vede senza WebGL e prima del primo frame. Il contenitore esterno
       sfuma il bordo basso e sta fermo; quello interno si muove in
       parallasse (così la luce non si taglia mai sul bordo della hero). -->
  <div class="hero-light" aria-hidden="true">
    <div class="hero-light-inner" data-layer="light">
      <canvas class="hero-light-canvas" data-hero-fluid></canvas>
      <span class="hero-grain"></span>
    </div>
  </div>

  <!-- A destra: LA VISTA ESPLOSA. Un sito vero (un cliente d'esempio, una
       baita sotto lo Sciliar) appare montato, un taglio lo attraversa e si
       apre a strati come un disegno tecnico: dal basso codice, struttura,
       design, contenuti e interazione. Ogni strato ha la sua etichetta con
       una linea di richiamo; gli strati si accendono a turno (o al passaggio
       del mouse) e scorrendo il sito si richiude.
       Regia in scripts/heroExplode.ts; entrata e inclinazione col mouse in
       logoHandoff.ts ([data-hero-stage], [data-hero-tilt]). -->
  <div class="hero-stage" data-hero-stage>
    <div class="hx" data-hx aria-hidden="true">
      <div class="hero-stage-tilt" data-hero-tilt>
        <div class="hx-iso" data-hx-iso>
          <span class="hx-ground"></span>

          <!-- 01 · Codice: la pagina com'è scritta. -->
          <div class="hx-ly hx-l-code" data-hx-ly="0">
            <span class="hx-code">
              {CODE.map((toks, i) => (
                <span class="hx-cl" style={`--i:${i}`}>
                  <i>{i + 1}</i>
                  {toks.map(([c, txt]) => <span class={`hx-t-${c}`}>{txt}</span>)}
                </span>
              ))}
            </span>
            <span class="hx-code-side">
              <b>build</b><span>0,8 s</span>
              <b>lighthouse</b><span>100</span>
              <b>js</b><span>9 kB</span>
            </span>
          </div>

          <!-- 02 · Struttura: griglia e scatole, quote come su un progetto. -->
          <div class="hx-ly hx-l-grid" data-hx-ly="1">
            <span class="hx-cols">{Array.from({ length: 12 }, () => <i></i>)}</span>
            <span class="hx-box hx-p-nav"><em>nav</em></span>
            <span class="hx-box hx-p-txt"><em>h1 · col 1–6</em></span>
            <span class="hx-box hx-p-img"><em>img 4:3</em></span>
            <span class="hx-box hx-p-bk"><em>form</em></span>
            <span class="hx-box hx-p-chat"><em>chat</em></span>
            <span class="hx-dim hx-dim-w"><em>1440</em></span>
          </div>

          <!-- 03 · Design: fondo, superfici, colori; i campioni in basso. -->
          <div class="hx-ly hx-l-design" data-hx-ly="2">
            <span class="hx-d-nav hx-p-nav"><i class="hx-d-btn"></i></span>
            <span class="hx-d-img hx-p-img"></span>
            <span class="hx-d-cta"></span>
            <span class="hx-d-bk hx-p-bk"><i></i><i></i><i></i><i class="hx-d-go"></i></span>
            <span class="hx-sw"><i style="--c:#171310"></i><i style="--c:#2748A5"></i><i style="--c:#D84002"></i><i style="--c:#FADFC9"></i><b>Aa</b></span>
          </div>

          <!-- 04 · Contenuti: testi, foto, campi. -->
          <div class="hx-ly hx-l-copy" data-hx-ly="3">
            <span class="hx-c-nav hx-p-nav">
              <b class="hx-brand"><svg viewBox="0 0 20 14"><path d="M1 13 7.5 3l3.5 5 2.5-3.5L19 13Z" /></svg>{x.site.brand}</b>
              <span class="hx-links">{x.site.nav.map((l) => <i>{l}</i>)}</span>
              <span class="hx-c-btn">{x.site.book}</span>
            </span>
            <span class="hx-c-txt hx-p-txt">
              <small>{x.site.kicker}</small>
              <strong>{x.site.title}</strong>
              <span>{x.site.sub}</span>
              <span class="hx-c-cta">{x.site.cta} →</span>
            </span>
            <span class="hx-c-img hx-p-img">
              <Image src={sciliar} widths={[480, 720]} sizes="18vw" quality={72} alt="" loading="eager" decoding="async" />
            </span>
            <span class="hx-c-bk hx-p-bk">
              {x.site.fields.map(([k, v]) => <span><small>{k}</small>{v}</span>)}
              <b>{x.site.check}</b>
            </span>
          </div>

          <!-- 05 · Interazione: quello che succede quando il sito lavora. -->
          <div class="hx-ly hx-l-ui" data-hx-ly="4">
            <span class="hx-rate"><b>★</b>{x.site.rating}</span>
            <span class="hx-toast"><i>✓</i>{x.site.toast}<small>22:47</small></span>
            <span class="hx-chat hx-p-chat">
              <span class="hx-chat-head"><i></i>{x.site.bot}<small>AI</small></span>
              <span class="hx-bubble">{x.site.chat}</span>
              <span class="hx-typing"><i></i><i></i><i></i></span>
            </span>
            <span class="hx-ptr">
              <svg viewBox="0 0 24 24"><path d="M5 3l14 8.2-6.1 1.3L10 18.6Z" /></svg>
              <i></i>
            </span>
          </div>

          <span class="hx-scan" data-hx-scan></span>
        </div>
      </div>

      <!-- Davanti: linee di montaggio sugli spigoli e richiami (disegnati
           in piano da heroExplode.ts, seguono gli strati). -->
      <svg class="hx-leads" data-hx-leads></svg>
    </div>
    <!-- Le etichette degli strati: sul desktop in colonna accanto alla scena
         (le posa heroExplode.ts), sul telefono una riga di chip sotto. -->
    <ol class="hx-labels" aria-hidden="true">
      {x.layers.map((l, i) => (
        <li class="hx-lab" data-hx-lab={i}>
          <span class="hx-lab-n">{String(i + 1).padStart(2, "0")}</span>
          <span class="hx-lab-t"><b>{l.n}</b><small>{l.d}</small></span>
        </li>
      ))}
    </ol>
  </div>

  <div data-anim="hero-content" class="hero-copy">
    <!-- Telefono: il posto del logo grande in cima (ci si posa il logo del
         preloader, logoHandoff.ts). Sul desktop non c'è. -->
    <span class="hero-logo-slot" data-logo-slot aria-hidden="true"></span>
    <span class="hero-logo-bar" aria-hidden="true"></span>
    <span
      data-anim="hero-label"
      class="hero-badge text-[11px] font-medium tracking-[0.15em] uppercase"
      style="opacity: 0;"
    >
      {t.home.hero.badge}
    </span>

    <h1 class="hero-title font-display font-medium text-[#171310]">
      <span data-anim="hero-line-1" class="block" style="opacity: 0;"><Rich text={t.home.hero.l1} /></span>{" "}
      <span data-anim="hero-line-2" class="block" style="opacity: 0;"><Rich text={t.home.hero.l2} /></span>{" "}
      <span data-anim="hero-line-3" class="block" style="opacity: 0;"><Rich text={t.home.hero.l3} /></span>
    </h1>

    <!-- Il piede del testo: un filo (come i richiami della scena), il
         sottotitolo a sinistra e le due CTA impilate a destra. -->
    <div class="hero-foot">
    <p data-anim="hero-subline" class="hero-sub text-[#544C40]" style="opacity: 0;">
      <Rich text={t.home.hero.sub} />
    </p>

    <div data-anim="hero-cta" class="hero-cta flex" style="opacity: 0;">
      <a href="#projects" class="pill text-[14px] px-8 py-[15px]">
        {t.home.hero.cta} <span aria-hidden="true">↗</span>
      </a>
      <!-- Secondario: vetro chiaro come il browser e la navbar, con il
           puntino "disponibili" che respira. Porta al form dei contatti. -->
      <a href="#contatti" class="hero-contact">
        <span class="hero-contact-dot" aria-hidden="true"></span>
        {t.home.hero.contact}
        <span class="hero-contact-arrow" aria-hidden="true">→</span>
      </a>
    </div>
    </div>
  </div>

  <!-- Telefono: LO SCILIAR A CURVE DI LIVELLO, in basso sotto il testo.
       Rilievo vero (quote reali, isoipse ogni 50 m) disegnato in WebGL da
       scripts/heroTopo.ts; sotto, la didascalia. Sul desktop non c'è. -->
  <div class="htopo" data-topo aria-hidden="true">
    <canvas class="htopo-canvas" data-topo-canvas></canvas>
    <span class="htopo-tag">{TAG}</span>
  </div>

  <!-- Hint di scroll — hairline con tratto accent che scorre in loop. -->
  <div class="hero-scroll-hint" data-anim="hero-hint" style="opacity: 0;" aria-hidden="true">
    <span class="hero-scroll-label">{t.home.hero.scroll}</span>
    <span class="hero-scroll-line"></span>
  </div>
</section>

<script>
  import "../scripts/heroFluid.ts";
  import "../scripts/heroExplode.ts";
  import { mountTopo } from "../scripts/heroTopo.ts";
  // Lo Sciliar solo sul telefono: sul desktop non si scaricano nemmeno le quote.
  const topo = document.querySelector<HTMLElement>("[data-topo]");
  if (topo && window.matchMedia("(max-width: 899px)").matches) mountTopo(topo);
</script>
