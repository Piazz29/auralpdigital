---
// SERVIZI — la card si scambia di posto con la descrizione.
//
// Card e testo occupano due posti affiancati (desktop) o sovrapposti
// (mobile) e a ogni scena se li SCAMBIANO: la card fa destra → sinistra →
// destra (mobile: sopra → sotto → sopra), il testo l'opposto.
//
// I pannelli immagine NON si muovono mai: stanno fermi nello spazio, uno per
// posto. È la card a spostarsi, e mentre si sposta funziona da CORNICE che
// scopre il pannello dell'altro posto — a metà corsa si vede il pannello che
// esce e quello che entra affiancati, come nello screenshot di riferimento.
// A card ferma, invece, la cornice inquadra un pannello solo e nulla scorre.
// La descrizione non viaggia: compare in dissolvenza nel posto liberato.
//
// Sopra a ogni card, sul bordo verso il testo, compare la notifica di "Il
// punto" RISOLTA (`fix` nel dizionario): lo stesso caos di prima, sistemato
// dal servizio. Il testo di ogni scena entra a tempo quando la card si posa
// (titolo parola per parola, poi descrizione, etichette e link).
//
// La regia (pin, scrub, misure dei posti) è in src/scripts/main.ts.
//
// CONTENUTO: titoli e descrizioni dal dizionario (`home.services`), nella
// lingua della pagina. Il visual di ogni servizio sta in `media` qui sotto:
// `video` (+ `poster`) per una clip in loop, `src` per un'immagine; senza
// nessuno dei due si vede il pannello segnaposto. Le clip suonano SOLO
// mentre la loro scena è nella cornice (regia in main.ts).
import type { Lang } from "../i18n";
import { defaultLang, getDict } from "../i18n";

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = getDict(lang).home.services;

// Dati strutturali per indice (stesso ordine del dizionario). `tint` serve
// solo a distinguere i segnaposto durante lo scambio.
const media: { video?: string; poster?: string; src?: string; tint: string }[] = [
  {
    // Clip originale (720×1280, con audio) in .video-originals/: qui senza
    // audio, ricodificata H.264 CRF 24 (veryslow, faststart): −60% di peso a
    // qualità indistinguibile (SSIM 0.99). È 9:16: la cornice 4:5 la ritaglia
    // in alto e in basso. Poster in webp.
    video: "/videos/services/siti.mp4?v=3",
    poster: "/videos/services/siti-poster.webp",
    tint: "39, 72, 165",
  },
  {
    // Stessa lavorazione della clip dei siti (originale in .video-originals/).
    video: "/videos/services/social.mp4?v=2",
    poster: "/videos/services/social-poster.webp",
    tint: "216, 64, 2",
  },
  {
    // Stessa lavorazione delle altre due (originale in .video-originals/).
    video: "/videos/services/gestionali.mp4?v=2",
    poster: "/videos/services/gestionali-poster.webp",
    tint: "28, 43, 95",
  },
];

const services = t.items.map((item, i) => ({ ...item, ...media[i] }));
const total = String(services.length).padStart(2, "0");

// Icona della notifica risolta, nello stesso ordine dei servizi: Google
// (siti), messaggio (social), telefono (gestionali) — le stesse di "Il punto".
const fixIcons = [
  '<circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />',
  '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z" />',
  '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" />',
];
---

<div class="svc" data-svc style={`--svc-count:${services.length}`}>
  <div class="svc-scene" data-svc-scene>
    <!-- LA FINESTRA — una sola, persistente: è lei a spostarsi di lato. -->
    <div class="svc-frame" data-svc-frame>
      <div class="svc-track" data-svc-track>
        {services.map((s, i) => (
          <figure class="svc-shot" data-svc-shot data-i={i} style={`--tint:${s.tint}; --z:${i}`}>
            {s.video ? (
              <video
                data-svc-video
                src={s.video}
                data-poster={s.poster}
                muted
                loop
                playsinline
                preload="none"
                aria-hidden="true"
              />
            ) : s.src ? (
              <img src={s.src} alt="" loading="lazy" decoding="async" />
            ) : (
              <div class="svc-ph" aria-hidden="true">
                <span class="svc-ph-label">Immagine segnaposto</span>
              </div>
            )}
          </figure>
        ))}
      </div>
    </div>

    <!-- LE NOTIFICHE RISOLTE — una per scena, ferma sul bordo della card di
         quella scena (il JS la mette nel posto giusto); entra a card posata. -->
    <div class="svc-fixes" aria-hidden="true">
      {services.map((s, i) => (
        <div class={`svc-fix ${i % 2 ? "svc-fix--right" : "svc-fix--left"}`} data-svc-fix>
          <span class="svc-fix-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={fixIcons[i]} />
            <span class="svc-fix-check">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
            </span>
          </span>
          <span class="svc-fix-text">
            <span class="svc-fix-title">{s.fix.title}</span>
            <span class="svc-fix-body">{s.fix.body}</span>
          </span>
        </div>
      ))}
    </div>

    <!-- LE DESCRIZIONI — impilate nello stesso spazio, si danno il cambio. -->
    <div class="svc-copies" data-svc-copies>
      {services.map((s, i) => (
        <article class="svc-copy" data-svc-copy data-i={i}>
          <span class="svc-num" data-svc-num>
            <span class="works-kicker svc-kicker">{t.kicker}</span>
            <span class="svc-num-i">{String(i + 1).padStart(2, "0")}</span>
            <span class="svc-num-of">/ {total}</span>
          </span>
          <h3 class="svc-title" data-svc-title>{s.name} <em>{s.nameEm}</em></h3>
          <p class="svc-desc" data-svc-desc>{s.desc}</p>
          <ul class="svc-tags">
            {s.tags.map((tag) => (
              <li class="svc-tag" data-svc-tag>{tag}</li>
            ))}
          </ul>
          <a class="svc-link" href="#contatti" data-svc-link>
            {t.link} <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>
  </div>

  <!-- Navigazione della sequenza: i tre servizi per nome, con una barra
       che si riempie seguendo il cambio. Cliccabili: portano alla scena. -->
  <div class="svc-dots">
    {services.map((s, i) => (
      <button type="button" class="svc-dot" data-i={i} data-svc-step>
        <span class="svc-dot-label">{s.short}</span>
        <span class="svc-dot-bar">
          <span class="svc-dot-fill" data-svc-fill></span>
        </span>
      </button>
    ))}
  </div>
</div>
