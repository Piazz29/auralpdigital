---
// NAVBAR — pillola semi-trasparente centrata (PillNav), multilingua.
// `home` decide il prefisso dei link ancora; `lang` localizza voci/contatti e
// lo switcher di lingua; `route` è la rotta base ('/', '/chi-siamo', '/faq')
// usata dallo switcher per costruire l'equivalente nelle altre lingue.
import type { Lang } from "../i18n";
import { defaultLang } from "../i18n";
import PillNav from "./reactbits/PillNav.jsx";

interface Props {
  home?: boolean;
  lang?: Lang;
  route?: string;
}
const { home = false, lang = defaultLang, route = "/" } = Astro.props;
---

<PillNav client:load home={home} lang={lang} route={route} />
