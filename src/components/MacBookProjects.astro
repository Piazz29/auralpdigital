---
// MacBookProjects — stage "MacBook Scroll" con un MacBook Pro 3D reale.
// Il laptop non è più HTML/CSS: è il modello glTF `mac.glb` renderizzato in
// WebGL dall'isola React MacBook3D (client:only). Il CONCETTO resta identico:
// la sezione si BLOCCA (pin, in main.ts via Lenis+ScrollTrigger), lo scroll apre
// il coperchio e fa avvicendare sullo schermo i progetti reali (video live +
// link cliccabili, proiettati sul pannello con <Html transform>), con le tab
// sotto per il salto diretto. main.ts non tocca più il DOM del laptop: pilota
// tutto tramite lo store globale window.__mbp (open continuo + index discreto).
//
// SSR/no-JS: il Canvas è client-only (WebGL non ha SSR). Un fallback statico
// `.mbp-fallback` con i link dei progetti resta nel markup per crawler e utenti
// senza JS; l'isola, al mount, aggiunge `.is-live` al contenitore e il CSS lo
// nasconde mostrando la scena 3D.

interface Project {
  n: string;
  title: string;
  titleEm: string;
  type: string;
  year: string;
  url: string;
  video: string;
  flag: string;
  cta: string;
  desc: string;
  status: "live" | "soon";
}

interface Props {
  projects: Project[];
  previewLabel: string;
  ctaAddress: string;
}

import MacBook3D from "@/components/reactbits/MacBook3D.jsx";

const { projects, previewLabel, ctaAddress } = Astro.props;
---

<div class="mbp-mount" data-mbp-mount data-mbp-count={projects.length}>
  <!-- Scena 3D (client-only): MacBook Pro glTF + schermo HTML + tab -->
  <MacBook3D
    client:only="react"
    projects={projects}
    previewLabel={previewLabel}
    ctaAddress={ctaAddress}
  />

  <!-- Fallback statico (SEO / no-JS / reduced-motion prima del mount) -->
  <div class="mbp-fallback">
    <ul class="mbp-fallback-list">
      {projects.map((p) => {
        const external = !!p.url && !p.url.startsWith("#");
        return (
          <li class="mbp-fallback-item">
            <a
              class="mbp-fallback-link"
              href={p.url}
              {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              <span class="mbp-fallback-n">{p.n}</span>
              <span class="mbp-fallback-title">{p.title} <em>{p.titleEm}</em></span>
              <span class="mbp-fallback-meta">{p.type}{p.year ? ` · ${p.year}` : ""}</span>
              <span class="mbp-fallback-cta">{p.cta} <span aria-hidden="true">↗</span></span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</div>
