---
// AboutPage — corpo della pagina "Chi siamo", parametrizzato per lingua. I dati
// strutturali (iniziali, gradienti, chiavi SVG, foto) restano qui; i testi
// vengono dal dizionario e si fondono per indice.
import type { Lang } from "../../i18n";
import { defaultLang, getDict, localePath } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../Navbar.astro";
import Footer from "../Footer.astro";
import Rich from "../Rich.astro";
import JourneyPath from "../reactbits/JourneyPath.jsx";
import FlowCardSwap from "../reactbits/FlowCardSwap.jsx";
import { Picture, getImage } from "astro:assets";
import julianPhoto from "../../assets/team/julian.png";
import alicePhoto from "../../assets/team/alice.png";
import "../../styles/global.css";

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = getDict(lang);
const ta = t.about;

// HERO — titolo "Normale *accento*" con "\n" come a-capo esplicito. Il punto
// finale dell'accento diventa un pixel quadrato (stesso segno delle card).
const heroLines = ta.hero.title.split("\n").map((line) =>
  line
    .split("*")
    .map((text, i) => ({ text, accent: i % 2 === 1 }))
    .filter((p) => p.text.length > 0)
);

// IL DUO — foto (placeholder fino allo shooting: basta sostituire i file in
// src/assets/team), tono di colore e testi tradotti fusi per indice. La
// sorgente del canvas a pixel è una webp leggera generata a build time.
const peopleMeta = [
  // zoom: quanto stringere sul volto nel ritratto a pixel della hero.
  { name: "Julian", photo: julianPhoto, tone: "ember", zoom: 1 },
  { name: "Alice", photo: alicePhoto, tone: "shadow", zoom: 1.3 },
] as const;
const people = await Promise.all(
  peopleMeta.map(async (m, i) => ({
    ...m,
    ...ta.people[i],
    pixelSrc: (await getImage({ src: m.photo, width: 640, format: "webp", quality: 82 })).src,
  }))
);

// Il manifesto: le parole dello statement si accendono una a una con lo
// scroll; le cifre dei fatti girano come un contachilometri. La striscia di
// ogni cifra finisce sul valore vero (10 cifre, l'ultima è quella giusta).
const facts = ta.manifesto.facts.map((f) => ({
  ...f,
  reel: Array.from({ length: 10 }, (_, k) => (f.n + 1 + k) % 10),
}));

// IL PERCORSO — le 4 tappe tradotte (gli asset 3D li sceglie JourneyPath).
const steps = ta.journey.steps.map((s) => ({
  year: s.year,
  kicker: s.kicker,
  title: s.title,
  text: s.text,
}));

// COME LAVORIAMO — numero strutturale + testi tradotti.
const workflow = ta.flow.items.map((it, i) => ({
  n: `0${i + 1}`,
  title: it.title,
  titleEm: it.titleEm,
  text: it.text,
  tag: it.tag,
}));
---

<BaseLayout lang={lang} title={t.meta.about.title} description={t.meta.about.description}>
  <Navbar lang={lang} route="/chi-siamo" />

  <main class="aboutpage">
    <!-- HERO — "Le persone dietro i pixel", alla lettera: i due ritratti sono
         griglie di tessere nei colori del brand e la lente (il cursore, o un
         percorso automatico) li rimette a fuoco. Fondo: l'aurora. -->
    <section class="ap-hero" data-ap-hero>
      <div class="ap-hero-aurora" aria-hidden="true"></div>

      <div class="ap-hero-inner">
        <div class="ap-hero-copy" data-ap-hero-copy>
          <div class="ap-hero-top" data-ap-hero-fade>
            <span class="works-kicker ap-hero-kicker">{ta.hero.badge}</span>
            <span class="ap-hero-status"><span class="ap-hero-status-dot" aria-hidden="true"></span>{ta.hero.status}</span>
          </div>

          <h1 class="ap-hero-title font-display" data-ap-hero-title>
            {heroLines.map((line) => (
              <span class="ap-hero-line">
                {line.map((p) =>
                  p.accent ? (
                    <em class="ap-hero-accent" data-ap-hero-accent>{p.text.replace(/\.$/, "")}{p.text.endsWith(".") && <span class="ap-px-dot" data-ap-px-dot aria-hidden="true"></span>}</em>
                  ) : (
                    <span>{p.text}</span>
                  )
                )}
              </span>
            ))}
          </h1>

          <p class="ap-hero-sub" data-ap-hero-fade>{ta.hero.sub}</p>

          <div class="ap-hero-cta" data-ap-hero-fade>
            <a href="#contatti" class="about-cta-btn ap-hero-btn magnetic">
              {ta.hero.cta} <span aria-hidden="true">↗</span>
            </a>
            <a href="#il-duo" class="ap-hero-meet">
              {ta.hero.meet} <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>

        <div class="ap-stage" data-ap-stage>
          <span class="ap-bit ap-bit--1" data-ap-bit style="--d: 0.6" aria-hidden="true"></span>
          <span class="ap-bit ap-bit--2" data-ap-bit style="--d: -0.9" aria-hidden="true"></span>
          <span class="ap-bit ap-bit--3" data-ap-bit style="--d: 1.2" aria-hidden="true"></span>
          <span class="ap-bit ap-bit--4" data-ap-bit style="--d: -0.5" aria-hidden="true"></span>
          <span class="ap-bit ap-bit--5" data-ap-bit style="--d: 0.8" aria-hidden="true"></span>

          {people.map((p, i) => (
            <figure class={`ap-portrait ap-portrait--${i + 1}`} data-ap-portrait>
              <div class="ap-portrait-frame">
                <canvas
                  class="ap-portrait-canvas"
                  data-px-lens
                  data-src={p.pixelSrc}
                  data-tone={p.tone}
                  data-zoom={p.zoom}
                  role="img"
                  aria-label={`${p.name} — ${p.area}`}
                ></canvas>
              </div>
              <figcaption class="ap-portrait-cap">
                <span class="ap-portrait-n">0{i + 1}</span>
                <span class="ap-portrait-name">{p.name}</span>
                <span class="ap-portrait-area">{p.area}</span>
              </figcaption>
            </figure>
          ))}

          <p class="ap-stage-hint" data-ap-hint>
            <span class="ap-stage-hint-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3l14 7-6 2-2 6z"/></svg>
            </span>
            <span class="ap-hint-desk">{ta.hero.hint}</span>
            <span class="ap-hint-touch">{ta.hero.hintTouch}</span>
          </p>
        </div>
      </div>
    </section>

    <!-- MANIFESTO — lo statement si accende parola per parola con lo scroll,
         poi i tre numeri che lo dimostrano. -->
    <section class="ap-manifesto" data-ap-manifesto>
      <div class="works-screen">
        <span class="works-kicker" data-ap-rise>{ta.manifesto.kicker}</span>
        <p class="ap-statement font-display" data-ap-statement>
          <Rich text={ta.manifesto.statement} />
        </p>

        <ol class="ap-facts">
          {facts.map((f) => (
            <li class="ap-fact" data-ap-fact>
              <span class="ap-fact-rule" aria-hidden="true"></span>
              <span class="ap-fact-n font-display" aria-label={String(f.n)}>
                <span class="ap-fact-reel" data-ap-reel aria-hidden="true">
                  {f.reel.map((d) => <span>{d}</span>)}
                </span>
              </span>
              <span class="ap-fact-label font-display">{f.label}</span>
              <span class="ap-fact-text">{f.text}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- IL DUO — due card editoriali sfalsate: la foto entra pixelata e si
         mette a fuoco (lo stesso gesto della hero), poi nome, ruolo, bio,
         una frase in prima persona e le aree di lavoro. -->
    <section id="il-duo" class="ap-duo" data-ap-duo>
      <div class="ap-duo-glow" aria-hidden="true"></div>
      <div class="works-screen">
        <div class="ap-duo-head">
          <div>
            <span class="works-kicker" data-ap-rise>{ta.duo.kicker}</span>
            <h2 class="works-title ap-duo-title" data-ap-rise><Rich text={ta.duo.title} /></h2>
          </div>
          <p class="ap-duo-lead" data-ap-rise>{ta.duo.lead}</p>
        </div>

        <div class="ap-cards">
          {people.map((p, i) => (
            <article class={`ap-card ap-card--${p.tone}`} data-ap-card>
              <div class="ap-card-media" data-ap-card-media>
                <Picture
                  src={p.photo}
                  formats={["avif", "webp"]}
                  widths={[480, 720, 960]}
                  sizes="(max-width: 860px) 92vw, 44vw"
                  alt={`${p.name} — ${p.title}, ${p.area}`}
                  class="ap-card-img"
                  loading="lazy"
                />
                <canvas class="ap-card-canvas" data-px-reveal data-src={p.pixelSrc} data-tone={p.tone} aria-hidden="true"></canvas>
                <span class="ap-card-chip">0{i + 1} · {p.title}</span>
              </div>

              <div class="ap-card-body">
                <div class="ap-card-namerow">
                  <h3 class="ap-card-name font-display" data-ap-card-name>{p.name}<span class="ap-px-dot" aria-hidden="true"></span></h3>
                  <span class="ap-card-area">{p.area}</span>
                </div>
                <p class="ap-card-bio" data-ap-card-in>{p.bio}</p>
                <blockquote class="ap-card-quote font-display" data-ap-card-in>
                  <span aria-hidden="true">«</span><Rich text={p.quote} /><span aria-hidden="true">»</span>
                </blockquote>
                <ul class="ap-card-tags" data-ap-card-in>
                  {p.focus.map((f) => <li>{f}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- IL PERCORSO — viaggio immersivo 3D scroll-driven: un cursore 3D vola
         tra le 4 tappe mentre la pagina scorre (JourneyPath). -->
    <section class="ap-section ap-journey">
      <div class="works-screen">
        <div class="works-head">
          <div class="works-head-left">
            <h2 class="works-title"><Rich text={ta.journey.title} /></h2>
          </div>
        </div>

        <JourneyPath client:idle steps={steps} />
      </div>
    </section>

    <!-- COME LAVORIAMO -->
    <section class="ap-section ap-flow ap-flow--plain">
      <div class="works-screen">
        <div class="ap-flow-inner ap-flow-inner--swap">
          <div class="ap-flow-copy">
            <span class="works-kicker ap-flow-kicker">{ta.flow.kicker}</span>
            <h2 class="works-title ap-flow-title">
              <Rich text={ta.flow.title} />
            </h2>
            <p class="ap-flow-lead">
              {ta.flow.lead}
            </p>
          </div>

          <div class="ap-flow-stage">
            <FlowCardSwap client:visible items={workflow} hint={ta.flow.hint} width={517} height={397} />
          </div>
        </div>
      </div>
    </section>

    <!-- SEPARATORE — linea sottile che introduce la CTA/form, con respiro
         extra perché lo stack di card di "Come lavoriamo" deborda verso il basso. -->
    <hr class="section-rule section-rule--airy" aria-hidden="true" />

    <!-- CTA FINALE -->
    <section id="contatti" class="about-cta" data-anim="contact">
      <span class="about-cta-glow" aria-hidden="true"></span>
      <span class="deco deco--star deco-accent deco-float-2" style="left: 12%; top: 22%;" aria-hidden="true">✦</span>
      <span class="deco deco--ring deco-peri deco-float-1" style="right: 13%; bottom: 24%;" aria-hidden="true"></span>

      <span class="works-kicker about-cta-kicker">{ta.cta.kicker}</span>

      <h2 class="about-cta-title font-display">
        <Rich text={ta.cta.title} />
      </h2>

      <p class="about-cta-sub">
        {ta.cta.sub}
      </p>

      <div class="about-cta-actions">
        <a href={`${localePath(lang, "/")}#contatti`} class="about-cta-btn magnetic">
          {ta.cta.btn} <span aria-hidden="true">↗</span>
        </a>
        <a href="mailto:hello@auralpdigital.com" class="about-cta-mail">
          {ta.cta.mail}
        </a>
      </div>

      <div class="about-cta-foot">
        {ta.cta.foot.map((f, i) => (
          <Fragment>
            {i > 0 && <span class="cta-foot-dot" aria-hidden="true"></span>}
            <span>{f}</span>
          </Fragment>
        ))}
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
