---
// AboutPage — corpo della pagina "Chi siamo", parametrizzato per lingua. I dati
// strutturali (iniziali, gradienti, chiavi SVG, foto) restano qui; i testi
// vengono dal dizionario e si fondono per indice.
import type { Lang } from "../../i18n";
import { defaultLang, getDict, localePath } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../Navbar.astro";
import Footer from "../Footer.astro";
import Rich from "../Rich.astro";
import BlurText from "../reactbits/BlurText.jsx";
import InteractiveRobotSpline from "../reactbits/InteractiveRobotSpline.jsx";
import HangBadge from "../HangBadge.astro";
import FlowCardSwap from "../reactbits/FlowCardSwap.jsx";
import JourneyPath from "../reactbits/JourneyPath.jsx";
import HeroProximityTitle from "../reactbits/HeroProximityTitle.jsx";
import "../../styles/global.css";

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = getDict(lang);
const ta = t.about;

// Scena Spline del robot interattivo della hero (hostata da Spline).
const ROBOT_SCENE = "https://prod.spline.design/PyzDhpQ9E5f1E3MT/scene.splinecode";

// Hero — il titolo usa la sintassi "Normale *accento*" con "\n" come a-capo
// ESPLICITO: ogni riga del dizionario è una riga tipografica (nowrap, mai
// spezzata dal wrapping — "dietro i pixel" resta sempre unito). Dentro ogni
// riga, i segmenti pari/dispari sono normale/accento per VariableProximity,
// che li renderizza in un'unica isola (containerRef condiviso).
const heroTitleParts = ta.hero.title.split("\n").flatMap((lineText, line) =>
  lineText
    .split("*")
    .map((text, i) => ({ text, accent: i % 2 === 1, line }))
    .filter((p) => p.text.length > 0)
);

// IL DUO — dati strutturali fusi con bio/ruoli/focus tradotti.
const peopleMeta = [
  { initial: "J", name: "Julian", grad: "grad-2", photo: "/team/julian.png" },
  { initial: "A", name: "Alice", grad: "grad-4", photo: "/team/alice.png" },
];
const people = peopleMeta.map((m, i) => ({
  ...m,
  role: ta.people[i].role,
  bio: ta.people[i].bio,
  focus: ta.people[i].focus,
}));

// IL PERCORSO — `art` seleziona l'SVG; il resto è tradotto.
const stepsMeta = ["uni", "spark", "studio", "next"];
const steps = stepsMeta.map((art, i) => ({
  art,
  year: ta.journey.steps[i].year,
  kicker: ta.journey.steps[i].kicker,
  title: ta.journey.steps[i].title,
  text: ta.journey.steps[i].text,
}));

// COME LAVORIAMO — numero strutturale + testi tradotti.
const workflow = ta.flow.items.map((it, i) => ({
  n: `0${i + 1}`,
  title: it.title,
  titleEm: it.titleEm,
  text: it.text,
  tag: it.tag,
}));

// Icone-firma per gli step del percorso (statiche, lingua-indipendenti).
const journeyArt: Record<string, string> = {
  uni: `<svg viewBox="0 0 64 64" fill="none" aria-hidden="true" class="ap-ico ap-ico--uni">
    <path class="ap-ico-line ap-ico-mortar" d="M6 25 L32 14 L58 25 L32 36 Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
    <path class="ap-ico-line" d="M17 29.5 V41 C17 45.4 24 48.5 32 48.5 C40 48.5 47 45.4 47 41 V29.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
    <g class="ap-ico-tassel">
      <line x1="58" y1="25" x2="58" y2="37" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
      <circle cx="58" cy="40" r="2.8" fill="currentColor"/>
    </g>
  </svg>`,
  spark: `<svg viewBox="0 0 64 64" fill="none" aria-hidden="true" class="ap-ico ap-ico--spark">
    <rect x="9" y="14" width="46" height="36" rx="5" stroke="currentColor" stroke-width="2.4"/>
    <line x1="9" y1="25" x2="55" y2="25" stroke="currentColor" stroke-width="2.4"/>
    <circle cx="15.5" cy="19.5" r="1.6" fill="currentColor"/>
    <circle cx="21.5" cy="19.5" r="1.6" fill="currentColor"/>
    <path class="ap-ico-line ap-ico-bk ap-ico-bk-l" d="M28 32 L22 38 L28 44" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
    <path class="ap-ico-line ap-ico-bk ap-ico-bk-r" d="M40 32 L46 38 L40 44" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
    <line class="ap-ico-caret" x1="33.5" y1="31" x2="31" y2="45" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
    <path class="ap-ico-sparkle" d="M50 8 L51.4 12 L55.4 13.4 L51.4 14.8 L50 18.8 L48.6 14.8 L44.6 13.4 L48.6 12 Z" fill="currentColor"/>
  </svg>`,
  studio: `<svg viewBox="0 0 64 64" fill="none" aria-hidden="true" class="ap-ico ap-ico--studio">
    <path class="ap-ico-line ap-ico-layer ap-ico-layer-1" d="M32 11 L54 23 L32 35 L10 23 Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
    <path class="ap-ico-line ap-ico-layer ap-ico-layer-2" d="M10 31 L32 43 L54 31" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
    <path class="ap-ico-line ap-ico-layer ap-ico-layer-3" d="M10 39 L32 51 L54 39" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>`,
  next: `<svg viewBox="0 0 64 64" fill="none" aria-hidden="true" class="ap-ico ap-ico--next">
    <circle class="ap-ico-orbit-track" cx="32" cy="32" r="22" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3 6" opacity="0.5"/>
    <path class="ap-ico-arrow" d="M20 44 L42 22 M30 21 L43 21 L43 34" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
    <g class="ap-ico-orbit"><circle cx="32" cy="10" r="2.8" fill="currentColor"/></g>
  </svg>`,
};
---

<BaseLayout lang={lang} title={t.meta.about.title} description={t.meta.about.description}>
  <Navbar lang={lang} route="/chi-siamo" />

  <main class="aboutpage">
    <!-- HERO — split 2 colonne "one-shot": copy editoriale a sinistra, robot
         Spline interattivo a destra, tutto dentro esattamente un viewport
         (100svh, overflow clip). -->
    <section class="ap-hero ap-hero--split">
      <div class="ap-hero-aurora" aria-hidden="true"></div>

      <div class="ap-hero-inner">
        <div class="ap-hero-grid">
          <div class="ap-hero-copy">
            <!-- opacity:0 inline = anti-flash (stesso pattern di badge/sub):
                 la riespone l'island HeroProximityTitle quando parte la
                 cascata split-text delle lettere (o subito, con
                 reduced-motion). -->
            <h1 class="ap-hero-title font-display" style="opacity: 0;">
              <HeroProximityTitle client:load parts={heroTitleParts} radius={140} />
            </h1>

            <p class="ap-hero-sub" style="opacity: 0;">
              {ta.hero.sub}
            </p>

            <div class="ap-hero-cta" style="opacity: 0;">
              <a href="#contatti" class="about-cta-btn ap-hero-btn magnetic">
                {ta.hero.cta} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <!-- Il robot vive in un "palco" a colonna: glow azzurro dietro,
               canvas Spline dentro. Interattivo col mouse su desktop; su
               touch il canvas è pointer-events:none (via CSS) così non ruba
               lo scroll. L'altezza è fissa → nessun layout shift quando la
               scena arriva. -->
          <div class="ap-hero-robot" style="opacity: 0;">
            <InteractiveRobotSpline
              client:only="react"
              scene={ROBOT_SCENE}
              label={ta.hero.robotAlt}
              hidden={["Plane"]}
              cameraOffsetY={-15}
            />
          </div>
        </div>

      </div>
    </section>

    <!-- MANIFESTO -->
    <section class="ap-section ap-manifesto">
      <div class="works-screen">
        <div class="ap-manifesto-grid">
          <div class="ap-manifesto-lead">
            <span class="ap-manifesto-mark" aria-hidden="true">✦</span>
          </div>

          <BlurText
            client:load
            text={ta.manifesto.statement}
            animateBy="words"
            direction="top"
            delay={120}
            stepDuration={0.4}
            className="ap-statement font-display ap-statement--blur"
          />

          <div class="ap-manifesto-aside" data-ap-reveal>
            {ta.manifesto.notes.map((note) => (
              <p class="ap-manifesto-note"><Rich text={note} /></p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- IL DUO — la sezione vive in un "campo" tecnico ultra-minimale:
         gridlines semi-trasparenti che si accendono attorno al cursore
         (mask-image su var --gx/--gy aggiornate da main.ts, solo pointer
         fine) e micro-coordinate editoriali agli angoli. Tutto aria-hidden,
         solo background/mask → nessun costo di layout. -->
    <section class="ap-section ap-section--deeper ap-duo-env">
      <div class="ap-duo-field" aria-hidden="true"></div>
      <span class="ap-duo-coord ap-duo-coord--br" aria-hidden="true">46.49° N · 11.35° E</span>
      <div class="works-screen">
        <div class="works-head">
          <div class="works-head-left">
            <h2 class="works-title"><Rich text={ta.duo.title} /></h2>
          </div>
        </div>

        <!-- Split-stage 50/50: ogni metà è il "palco" di una persona — indice
             e ruolo in testa, la card fotografica appesa al centro, il nome
             gigante sotto. Al passaggio del mouse la metà si accende (glow +
             iniziale watermark), l'altra si spegne, e bio + aree focus
             affiorano. Solo opacity/transform/filter: la geometria del
             documento NON cambia mai (gli ScrollTrigger a valle — il pin del
             Percorso — restano validi). Su touch tutto è visibile. -->
        <div class="ap-duo">
          {people.map((person, i) => (
            <div class={`ap-person${i % 2 === 1 ? " ap-person--flip" : ""}`}>
              <span class="ap-duo-mark font-display" aria-hidden="true">{person.initial}</span>
              <div class="ap-duo-head">
                <span class="ap-duo-index">0{i + 1}</span>
                <span class="ap-bio-role">{person.role}</span>
              </div>
              <HangBadge
                initial={person.initial}
                name={person.name}
                role={person.role}
                grad={person.grad}
                photo={person.photo || undefined}
              />
              <div class="ap-bio">
                <h3 class="ap-bio-name font-display">{person.name}<em>.</em></h3>
                <div class="ap-duo-more">
                  <div class="ap-duo-more-in">
                    <p class="ap-bio-text">{person.bio}</p>
                    <ul class="ap-focus">
                      {person.focus.map((f) => <li>{f}</li>)}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- IL PERCORSO — viaggio immersivo 3D scroll-driven. L'island JourneyPath
         si attiva solo con WebGL + niente reduced-motion: in quel caso pinna la
         sezione e fa volare il cursore 3D tra le 4 tappe (classe
         `ap-journey-3d--on` aggiunta via JS). Altrimenti resta la timeline
         statica qui sotto, che è anche il fallback SEO/no-JS/reduced-motion. -->
    <section class="ap-section ap-journey ap-journey-3d">
      <div class="works-screen">
        <div class="works-head">
          <div class="works-head-left">
            <h2 class="works-title"><Rich text={ta.journey.title} /></h2>
          </div>
        </div>

        <JourneyPath client:idle steps={steps} />

        <ol class="ap-timeline ap-timeline--fallback">
          <span class="ap-line" aria-hidden="true"></span>
          {steps.map((s, i) => (
            <li class={`ap-step ap-step--${i % 2 === 0 ? "left" : "right"}`}>
              <div class="ap-step-art" set:html={journeyArt[s.art]}></div>
              <div class="ap-step-body">
                <span class="ap-step-year">{s.year}</span>
                <span class="ap-step-kicker">{s.kicker}</span>
                <h3 class="ap-step-title font-display">{s.title}</h3>
                <p class="ap-step-text" data-glow>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- COME LAVORIAMO -->
    <section class="ap-section ap-flow ap-flow--plain">
      <div class="works-screen">
        <div class="ap-flow-inner ap-flow-inner--swap">
          <div class="ap-flow-copy">
            <span class="works-kicker ap-flow-kicker">{ta.flow.kicker}</span>
            <h2 class="works-title ap-flow-title">
              <Rich text={ta.flow.title} />
            </h2>
            <p class="ap-flow-lead">
              {ta.flow.lead}
            </p>
          </div>

          <div class="ap-flow-stage">
            <FlowCardSwap client:visible items={workflow} hint={ta.flow.hint} width={517} height={397} />
          </div>
        </div>
      </div>
    </section>

    <!-- SEPARATORE — linea sottile che introduce la CTA/form, con respiro
         extra perché lo stack di card di "Come lavoriamo" deborda verso il basso. -->
    <hr class="section-rule section-rule--airy" aria-hidden="true" />

    <!-- CTA FINALE -->
    <section id="contatti" class="about-cta" data-anim="contact">
      <span class="about-cta-glow" aria-hidden="true"></span>
      <span class="deco deco--star deco-accent deco-float-2" style="left: 12%; top: 22%;" aria-hidden="true">✦</span>
      <span class="deco deco--ring deco-peri deco-float-1" style="right: 13%; bottom: 24%;" aria-hidden="true"></span>

      <span class="works-kicker about-cta-kicker">{ta.cta.kicker}</span>

      <h2 class="about-cta-title font-display">
        <Rich text={ta.cta.title} />
      </h2>

      <p class="about-cta-sub">
        {ta.cta.sub}
      </p>

      <div class="about-cta-actions">
        <a href={`${localePath(lang, "/")}#contatti`} class="about-cta-btn magnetic">
          {ta.cta.btn} <span aria-hidden="true">↗</span>
        </a>
        <a href="mailto:hello@auralpdigital.com" class="about-cta-mail">
          {ta.cta.mail}
        </a>
      </div>

      <div class="about-cta-foot">
        {ta.cta.foot.map((f, i) => (
          <Fragment>
            {i > 0 && <span class="cta-foot-dot" aria-hidden="true"></span>}
            <span>{f}</span>
          </Fragment>
        ))}
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
