---
// AboutPage — corpo della pagina "Chi siamo", parametrizzato per lingua. I dati
// strutturali (iniziali, gradienti, chiavi SVG, foto) restano qui; i testi
// vengono dal dizionario e si fondono per indice.
import type { Lang } from "../../i18n";
import { defaultLang, getDict, localePath } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../Navbar.astro";
import Footer from "../Footer.astro";
import Rich from "../Rich.astro";
import BlurText from "../reactbits/BlurText.jsx";
import HangBadge from "../HangBadge.astro";
import FlowCardSwap from "../reactbits/FlowCardSwap.jsx";
import JourneyPath from "../reactbits/JourneyPath.jsx";
import HeroProximityTitle from "../reactbits/HeroProximityTitle.jsx";
import "../../styles/global.css";

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = getDict(lang);
const ta = t.about;

// Hero — il titolo usa la sintassi "Normale *accento*" con "\n" come a-capo
// ESPLICITO: ogni riga del dizionario è una riga tipografica (nowrap, mai
// spezzata dal wrapping — "dietro i pixel" resta sempre unito). Dentro ogni
// riga, i segmenti pari/dispari sono normale/accento per VariableProximity,
// che li renderizza in un'unica isola (containerRef condiviso).
const heroTitleParts = ta.hero.title.split("\n").flatMap((lineText, line) =>
  lineText
    .split("*")
    .map((text, i) => ({ text, accent: i % 2 === 1, line }))
    .filter((p) => p.text.length > 0)
);

// IL DUO — dati strutturali fusi con bio/ruoli/focus tradotti.
const peopleMeta = [
  { initial: "J", name: "Julian", grad: "grad-2", photo: "/team/julian.png" },
  { initial: "A", name: "Alice", grad: "grad-4", photo: "/team/alice.png" },
];
const people = peopleMeta.map((m, i) => ({
  ...m,
  role: ta.people[i].role,
  bio: ta.people[i].bio,
  focus: ta.people[i].focus,
}));

// IL PERCORSO — le 4 tappe tradotte (gli asset 3D li sceglie JourneyPath).
const steps = ta.journey.steps.map((s) => ({
  year: s.year,
  kicker: s.kicker,
  title: s.title,
  text: s.text,
}));

// COME LAVORIAMO — numero strutturale + testi tradotti.
const workflow = ta.flow.items.map((it, i) => ({
  n: `0${i + 1}`,
  title: it.title,
  titleEm: it.titleEm,
  text: it.text,
  tag: it.tag,
}));
---

<BaseLayout lang={lang} title={t.meta.about.title} description={t.meta.about.description}>
  <Navbar lang={lang} route="/chi-siamo" />

  <main class="aboutpage">
    <!-- HERO — colonna editoriale "one-shot": titolo, sub e CTA dentro
         esattamente un viewport (100svh, overflow clip). Lo spazio negativo
         lo tiene l'aurora di fondo, nessun asset 3D. -->
    <section class="ap-hero ap-hero--split">
      <div class="ap-hero-aurora" aria-hidden="true"></div>

      <div class="ap-hero-inner">
        <div class="ap-hero-copy">
          <!-- opacity:0 inline = anti-flash (stesso pattern di badge/sub):
               la riespone l'island HeroProximityTitle quando parte la
               cascata split-text delle lettere (o subito, con
               reduced-motion). -->
          <h1 class="ap-hero-title font-display" style="opacity: 0;">
            <HeroProximityTitle client:load parts={heroTitleParts} radius={140} />
          </h1>

          <p class="ap-hero-sub" style="opacity: 0;">
            {ta.hero.sub}
          </p>

          <div class="ap-hero-cta" style="opacity: 0;">
            <a href="#contatti" class="about-cta-btn ap-hero-btn magnetic">
              {ta.hero.cta} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- MANIFESTO -->
    <section class="ap-section ap-manifesto">
      <div class="works-screen">
        <div class="ap-manifesto-grid">
          <div class="ap-manifesto-lead">
            <span class="ap-manifesto-mark" aria-hidden="true">✦</span>
          </div>

          <BlurText
            client:load
            text={ta.manifesto.statement}
            animateBy="words"
            direction="top"
            delay={120}
            stepDuration={0.4}
            className="ap-statement font-display ap-statement--blur"
          />

          <div class="ap-manifesto-aside" data-ap-reveal>
            {ta.manifesto.notes.map((note) => (
              <p class="ap-manifesto-note"><Rich text={note} /></p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- IL DUO — la sezione vive in un "campo" tecnico ultra-minimale:
         gridlines semi-trasparenti che si accendono attorno al cursore
         (mask-image su var --gx/--gy aggiornate da main.ts, solo pointer
         fine) e micro-coordinate editoriali agli angoli. Tutto aria-hidden,
         solo background/mask → nessun costo di layout. -->
    <section class="ap-section ap-section--deeper ap-duo-env">
      <div class="ap-duo-field" aria-hidden="true"></div>
      <span class="ap-duo-coord ap-duo-coord--br" aria-hidden="true">46.49° N · 11.35° E</span>
      <div class="works-screen">
        <div class="works-head">
          <div class="works-head-left">
            <h2 class="works-title"><Rich text={ta.duo.title} /></h2>
          </div>
        </div>

        <!-- Split-stage 50/50: ogni metà è il "palco" di una persona — indice
             e ruolo in testa, la card fotografica appesa al centro, il nome
             gigante sotto. Al passaggio del mouse la metà si accende (glow +
             iniziale watermark), l'altra si spegne, e bio + aree focus
             affiorano. Solo opacity/transform/filter: la geometria del
             documento NON cambia mai (gli ScrollTrigger a valle — il pin del
             Percorso — restano validi). Su touch tutto è visibile. -->
        <div class="ap-duo">
          {people.map((person, i) => (
            <div class={`ap-person${i % 2 === 1 ? " ap-person--flip" : ""}`}>
              <span class="ap-duo-mark font-display" aria-hidden="true">{person.initial}</span>
              <div class="ap-duo-head">
                <span class="ap-duo-index">0{i + 1}</span>
                <span class="ap-bio-role">{person.role}</span>
              </div>
              <HangBadge
                initial={person.initial}
                name={person.name}
                role={person.role}
                grad={person.grad}
                photo={person.photo || undefined}
              />
              <div class="ap-bio">
                <h3 class="ap-bio-name font-display">{person.name}<em>.</em></h3>
                <div class="ap-duo-more">
                  <div class="ap-duo-more-in">
                    <p class="ap-bio-text">{person.bio}</p>
                    <ul class="ap-focus">
                      {person.focus.map((f) => <li>{f}</li>)}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- IL PERCORSO — viaggio immersivo 3D scroll-driven: un cursore 3D vola
         tra le 4 tappe mentre la pagina scorre (JourneyPath). -->
    <section class="ap-section ap-journey">
      <div class="works-screen">
        <div class="works-head">
          <div class="works-head-left">
            <h2 class="works-title"><Rich text={ta.journey.title} /></h2>
          </div>
        </div>

        <JourneyPath client:idle steps={steps} />
      </div>
    </section>

    <!-- COME LAVORIAMO -->
    <section class="ap-section ap-flow ap-flow--plain">
      <div class="works-screen">
        <div class="ap-flow-inner ap-flow-inner--swap">
          <div class="ap-flow-copy">
            <span class="works-kicker ap-flow-kicker">{ta.flow.kicker}</span>
            <h2 class="works-title ap-flow-title">
              <Rich text={ta.flow.title} />
            </h2>
            <p class="ap-flow-lead">
              {ta.flow.lead}
            </p>
          </div>

          <div class="ap-flow-stage">
            <FlowCardSwap client:visible items={workflow} hint={ta.flow.hint} width={517} height={397} />
          </div>
        </div>
      </div>
    </section>

    <!-- SEPARATORE — linea sottile che introduce la CTA/form, con respiro
         extra perché lo stack di card di "Come lavoriamo" deborda verso il basso. -->
    <hr class="section-rule section-rule--airy" aria-hidden="true" />

    <!-- CTA FINALE -->
    <section id="contatti" class="about-cta" data-anim="contact">
      <span class="about-cta-glow" aria-hidden="true"></span>
      <span class="deco deco--star deco-accent deco-float-2" style="left: 12%; top: 22%;" aria-hidden="true">✦</span>
      <span class="deco deco--ring deco-peri deco-float-1" style="right: 13%; bottom: 24%;" aria-hidden="true"></span>

      <span class="works-kicker about-cta-kicker">{ta.cta.kicker}</span>

      <h2 class="about-cta-title font-display">
        <Rich text={ta.cta.title} />
      </h2>

      <p class="about-cta-sub">
        {ta.cta.sub}
      </p>

      <div class="about-cta-actions">
        <a href={`${localePath(lang, "/")}#contatti`} class="about-cta-btn magnetic">
          {ta.cta.btn} <span aria-hidden="true">↗</span>
        </a>
        <a href="mailto:hello@auralpdigital.com" class="about-cta-mail">
          {ta.cta.mail}
        </a>
      </div>

      <div class="about-cta-foot">
        {ta.cta.foot.map((f, i) => (
          <Fragment>
            {i > 0 && <span class="cta-foot-dot" aria-hidden="true"></span>}
            <span>{f}</span>
          </Fragment>
        ))}
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
