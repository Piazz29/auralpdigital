---
// FaqPage — corpo della pagina FAQ, parametrizzato per lingua. Contenuti dal
// dizionario (t.faq). Su desktop tutto sta in UNA schermata (FaqExplorer:
// indice delle categorie a sinistra, domande a destra), poi il footer. Sfondo
// DotGrid interattivo dietro al contenuto. Raggiungibile dal menu hamburger.
import type { Lang } from "../../i18n";
import { defaultLang, getDict, localePath } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../Navbar.astro";
import Footer from "../Footer.astro";
import FaqExplorer from "../reactbits/FaqExplorer.jsx";
import FaqBackground from "../reactbits/FaqBackground.jsx";
import "../../styles/global.css";

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = getDict(lang);
const f = t.faq;

const metaTitle = `${f.title} — AuralpDigital`;
---

<BaseLayout lang={lang} title={metaTitle} description={f.subtitle}>
  <Navbar lang={lang} route="/faq" />

  <main class="faqpage">
    <!-- Sfondo DotGrid: layer fisso dietro al contenuto, non interattivo come
         box (gli eventi li ascolta su window il componente). -->
    <div class="faq-bg" aria-hidden="true">
      <FaqBackground client:idle />
    </div>

    <section class="faq-screen">
      <FaqExplorer
        client:load
        categories={f.categories}
        kicker="FAQ"
        title={f.title}
        subtitle={f.subtitle}
        cta={{ text: f.cta.text, button: f.cta.button, href: localePath(lang, "/#contatti") }}
      />
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
