---
// LOGO HANDOFF — l'UNICO logo animato della pagina: fisso, sopra a tutto,
// fuori da navbar e hero. Fa da preloader (contorno che si disegna, poi il
// pieno che sale), si posa nella hero e con lo scroll viaggia fino al posto
// del logo della navbar, misurato dal vivo (scripts/logoHandoff.ts).
//
// I tracciati vengono dal file del logo (public/logo/wordmark.svg), letto in
// build: una sola fonte. Ogni colore del file è mappato sul suo token di
// @theme; un colore nuovo nel logo senza token fa fallire la build.
import { readFileSync } from "node:fs";
import { join } from "node:path";

const svg = readFileSync(join(process.cwd(), "public/logo/wordmark.svg"), "utf8");
const viewBox = svg.match(/viewBox="([^"]+)"/)?.[1] ?? "0 0 556 119";
const [, , vbW, vbH] = viewBox.split(/\s+/).map(Number);
const groupTransform = svg.match(/<g transform="([^"]+)"/)?.[1];

const TONES: Record<string, string> = {
  "#1C2B5F": "navy", // --color-navy
  "#2748A5": "accent", // --color-accent
  "#A6AAB0": "steel", // --color-steel
};
const paths = [...svg.matchAll(/<path d="([^"]+)" fill="([^"]+)"/g)].map(([, d, fill]) => {
  const tone = TONES[fill.toUpperCase()];
  if (!tone) throw new Error(`LogoHandoff: colore ${fill} del logo senza token`);
  return { d, tone };
});
---

<div class="handoff-cover" data-handoff-cover aria-hidden="true"></div>
<!-- Burger della home: in hero la navbar non c'è ancora, ma il menu deve
     essere sempre a portata. Sta nell'angolo e con lo scroll scivola al posto
     del burger della navbar, come il logo; apre il menu vero. -->
<button
  type="button"
  class="handoff-burger"
  data-handoff-burger
  aria-controls="pnav-panel"
  aria-expanded="false"
  aria-label="Menu"
>
  <span class="handoff-burger-line"></span>
  <span class="handoff-burger-line"></span>
</button>
<div
  class="handoff-logo"
  data-handoff-logo
  aria-hidden="true"
  style={`--handoff-ar: ${vbH / vbW};`}
>
  <svg viewBox={viewBox} width={vbW} height={vbH} focusable="false">
    <defs>
      <clipPath id="handoff-fill-clip" clipPathUnits="userSpaceOnUse">
        <rect data-handoff-fill-rect x="0" y={vbH} width={vbW} height={vbH} />
      </clipPath>
    </defs>
    <g class="handoff-outline" data-handoff-outline transform={groupTransform}>
      {paths.map((p) => <path d={p.d} data-tone={p.tone} pathLength="1" />)}
    </g>
    <g clip-path="url(#handoff-fill-clip)">
      <g class="handoff-fill" transform={groupTransform}>
        {paths.map((p) => <path d={p.d} data-tone={p.tone} />)}
      </g>
    </g>
  </svg>
</div>
